generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  HR
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  ARCHIVED
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  OTHER
}

enum LeaveStatus {
  PLANNED
  APPROVED
  COMPLETED
  CANCELLED
}

enum DocumentCategory {
  CONTRACT
  IDENTIFICATION
  AGREEMENT
  CERTIFICATE
  OTHER
}

enum CandidateStatus {
  NEW
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  REVIEW
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RevenueCategory {
  WEBSITE
  LANDING_PAGE
  ECOMMERCE
  MAINTENANCE
  ADVERTISING
  CONSULTING
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  PAYPAL
  OTHER
}

enum ExpenseCategory {
  SOFTWARE
  AI_TOOLS
  HOSTING
  DOMAINS
  ADVERTISING
  EQUIPMENT
  HARDWARE
  OFFICE
  MARKETING
  SUBSCRIPTIONS
  SERVICES
  BANK_FEES
  TRANSPORTATION
  OTHER
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SalaryFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

enum PayrollType {
  SALARY
  BONUS
  COMMISSION
  OTHER
}

enum PayrollStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(HR)
  employeeId   String?   @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])
  sessions     Session[]
  auditLogs    AuditLog[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model Department {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  leadId      String?
  lead        Employee?  @relation("DepartmentLead", fields: [leadId], references: [id], onDelete: SetNull)
  employees   Employee[] @relation("EmployeeDepartment")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Position {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  employees   Employee[]
  candidates  Candidate[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Employee {
  id               String         @id @default(cuid())
  firstName        String
  lastName         String
  email            String         @unique
  phone            String?
  address          String?
  emergencyContact String?
  positionId       String?
  position         Position?      @relation(fields: [positionId], references: [id], onDelete: SetNull)
  departmentId     String?
  department       Department?    @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  teamLeaderId     String?
  teamLeader       Employee?      @relation("TeamMembers", fields: [teamLeaderId], references: [id], onDelete: SetNull)
  teamMembers      Employee[]     @relation("TeamMembers")
  ledDepartments   Department[]   @relation("DepartmentLead")
  employmentType   EmploymentType @default(FULL_TIME)
  startDate        DateTime       @default(now())
  status           EmployeeStatus @default(ACTIVE)
  performanceNotes String?
  user             User?
  leaves           Leave[]
  documents        Document[]
  projectMemberships ProjectMember[]
  ledProjects      Project[]      @relation("ProjectLead")
  tasks            Task[]
  salaries         Salary[]
  payments         Payment[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
  @@index([departmentId])
  @@index([positionId])
  @@index([lastName, firstName])
}

model Leave {
  id         String      @id @default(cuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       LeaveType
  startDate  DateTime
  endDate    DateTime
  status     LeaveStatus @default(PLANNED)
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
}

model Document {
  id             String           @id @default(cuid())
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name           String
  category       DocumentCategory
  fileName       String
  filePath       String
  mimeType       String?
  expirationDate DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([employeeId])
  @@index([expirationDate])
}

model Candidate {
  id         String          @id @default(cuid())
  name       String
  email      String
  phone      String?
  positionId String?
  position   Position?       @relation(fields: [positionId], references: [id], onDelete: SetNull)
  status     CandidateStatus @default(NEW)
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([status])
  @@index([email])
}

model Project {
  id          String          @id @default(cuid())
  name        String
  client      String?
  description String?
  status      ProjectStatus   @default(PLANNING)
  startDate   DateTime?
  deadline    DateTime?
  teamLeaderId String?
  teamLeader  Employee?       @relation("ProjectLead", fields: [teamLeaderId], references: [id], onDelete: SetNull)
  members     ProjectMember[]
  tasks       Task[]
  revenues    Revenue[]
  expenses    Expense[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
  @@index([client])
  @@index([deadline])
}

model ProjectMember {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([projectId, employeeId])
  @@index([employeeId])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    Employee?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([projectId])
  @@index([dueDate])
}

model Revenue {
  id            String          @id @default(cuid())
  client        String
  projectId     String?
  project       Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectLabel  String?
  category      RevenueCategory
  amount        Decimal         @db.Decimal(12, 2)
  date          DateTime
  paymentStatus PaymentStatus   @default(PENDING)
  paymentMethod PaymentMethod?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([date])
  @@index([client])
  @@index([category])
  @@index([paymentStatus])
  @@index([projectId])
}

model Expense {
  id            String          @id @default(cuid())
  provider      String
  description   String?
  category      ExpenseCategory
  amount        Decimal         @db.Decimal(12, 2)
  date          DateTime
  paymentMethod PaymentMethod?
  recurring     Boolean         @default(false)
  projectId     String?
  project       Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([date])
  @@index([category])
  @@index([provider])
  @@index([projectId])
}

model RecurringExpense {
  id              String             @id @default(cuid())
  provider        String
  amount          Decimal            @db.Decimal(12, 2)
  frequency       RecurringFrequency @default(MONTHLY)
  nextPaymentDate DateTime
  category        ExpenseCategory
  active          Boolean            @default(true)
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([active])
  @@index([nextPaymentDate])
}

model Salary {
  id        String          @id @default(cuid())
  employeeId String
  employee  Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount    Decimal         @db.Decimal(12, 2)
  frequency SalaryFrequency @default(MONTHLY)
  effectiveDate DateTime
  endDate   DateTime?
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([employeeId])
  @@index([effectiveDate])
}

model Payment {
  id         String        @id @default(cuid())
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       PayrollType   @default(SALARY)
  amount     Decimal       @db.Decimal(12, 2)
  date       DateTime
  period     String?
  status     PayrollStatus @default(PENDING)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([employeeId])
  @@index([date])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entity     String
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}
